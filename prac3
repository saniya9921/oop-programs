//3 Write a program in C++ to sort the numbers in an array using separate functions for
read, display, sort and swap. The objective of this assignment is to learn the
concepts of input, output, functions, call by reference in C++.

#include <iostream>                  // Includes input and output library
using namespace std;                 // Allows us to use cin and cout directly

// Function to read array elements
void read(int a[], int n)
{
    cout << "Enter " << n << " numbers: ";  // Asks user to enter numbers

    // Loop to accept array elements
    for(int i = 0; i < n; i++)
    {
        cin >> a[i];                 // Stores each number in the array
    }
}

// Function to swap two numbers using Call by Reference
void swapNum(int &x, int &y)
{
    int temp = x;                    // Stores value of x temporarily
    x = y;                            // Assigns value of y to x
    y = temp;                         // Assigns old value of x to y
}

// Function to sort the array using Bubble Sort
void sortArray(int a[], int n)
{
    // Outer loop for each pass
    for(int i = 0; i < n - 1; i++)
    {
        // Inner loop to compare adjacent elements
        for(int j = 0; j < n - 1 - i; j++)
        {
            // Checks if current element is greater than next element
            if(a[j] > a[j + 1])
            {
                swapNum(a[j], a[j + 1]);  // Swaps the two elements
            }
        }
    }
}

// Function to display array elements
void display(int a[], int n)
{
    // Loop to display all array elements
    for(int i = 0; i < n; i++)
    {
        cout << a[i] << " ";          // Prints each element
    }
}

int main()
{
    int a[5];                         // Creates an array of 5 integers

    read(a, 5);                       // Calls read() to accept array elements

    cout << "Before sorting: ";       // Displays message before sorting
    display(a, 5);                    // Displays the original array

    sortArray(a, 5);                  // Calls function to sort the array

    cout << "\nAfter sorting: ";      // Displays message after sorting
    display(a, 5);                    // Displays the sorted array

    return 0;                         // Ends the program successfully
}
