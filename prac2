//2 Find out the sum of even numbers between 1 to 50 using loops.
#include<iostream>                       // Includes input and output library
using namespace std;                      // Allows us to use cout directly

int main()
{
    int sum = 0;                          // Variable to store the sum of even numbers

    // Loop from 1 to 50
    for(int i = 1; i <= 50; i++)
    {
        // Check if the number is even
        if(i % 2 == 0)
        {
            sum = sum + i;                // Add the even number to sum
        }
    }

    // Display the final sum
    cout << "Sum of even numbers from 1 to 50 = " << sum;

    return 0;                             // Ends the program successfully
}
